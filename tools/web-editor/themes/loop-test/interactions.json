{
  "formatVersion": "0.4",
  "animations": [],
  "events": [],
  "bindings": [],
  "vars": { "t": { "value": 1, "min": 0, "max": 1 } },
  "rules": [
    {
      "id": "loop_demo",
      "when": { "trigger": "session" },
      "then": [
        { "type": "setVar", "var": "t", "expr": "1 - t" },
        { "type": "setProperty", "target": "pulse", "property": "opacity",
          "expr": "t", "duration": 200, "easing": "easeOut",
          "repeat": 6, "intervalMs": 700 }
      ]
    }
  ]
}