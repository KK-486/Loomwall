{
  "formatVersion": "0.2",
  "animations": [
    {
      "id": "anim_breath",
      "targetId": "accessGranted",
      "trigger": {
        "type": "always"
      },
      "tracks": [
        {
          "property": "opacity",
          "durationMs": 2600,
          "loop": "pingpong",
          "keyframes": [
            {
              "t": 0,
              "value": 1,
              "easing": "easeInOut"
            },
            {
              "t": 1,
              "value": 0.55,
              "easing": "easeInOut"
            }
          ]
        }
      ]
    },
    {
      "id": "anim_scan",
      "targetId": "scanHighlight",
      "trigger": {
        "type": "always"
      },
      "tracks": [
        {
          "property": "x",
          "durationMs": 3200,
          "loop": "loop",
          "keyframes": [
            {
              "t": 0,
              "value": 3,
              "easing": "linear"
            },
            {
              "t": 1,
              "value": 100,
              "easing": "linear"
            }
          ]
        }
      ]
    },
    {
      "id": "anim_danger",
      "targetId": "dangerTag",
      "trigger": {
        "type": "always"
      },
      "tracks": [
        {
          "property": "opacity",
          "durationMs": 900,
          "loop": "pingpong",
          "keyframes": [
            {
              "t": 0,
              "value": 1,
              "easing": "easeInOut"
            },
            {
              "t": 1,
              "value": 0.15,
              "easing": "easeInOut"
            }
          ]
        }
      ]
    }
  ],
  "bindings": [
    {
      "targetId": "batteryCover",
      "property": "x",
      "source": "sys.battery.level",
      "in": [
        0,
        100
      ],
      "out": [
        9.5,
        30
      ]
    }
  ],
  "events": [
    {
      "id": "ev_hit_short_0",
      "targetId": "hit_short_0",
      "gesture": "tap",
      "action": {
        "type": "launchApp",
        "package": "com.sina.weibo"
      }
    },
    {
      "id": "ev_hit_short_1",
      "targetId": "hit_short_1",
      "gesture": "tap",
      "action": {
